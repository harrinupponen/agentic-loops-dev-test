NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local docker-compose Postgres
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
COOKIE_SECRET=replace-me-with-at-least-32-characters-of-entropy

LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
SESSION_TTL_HOURS=168
# How long a stored Idempotency-Key outcome stays replayable.
IDEMPOTENCY_TTL_HOURS=24
# How long an emailed password-reset token stays usable.
PASSWORD_RESET_TTL_MINUTES=30
# Password reset requests per hour, per IP. Tighter than AUTH_RATE_LIMIT_MAX
# because each one costs someone else an email. The 60-second per-account
# cooldown that bounds inbox bombing lives in the database and is not a knob.
PASSWORD_RESET_RATE_LIMIT_MAX=5
# How long an emailed verification token stays usable. Hours, not minutes: a
# verification mail is routinely opened the next morning. Nothing in the
# application is gated on the result — see
# docs/adr/0011-email-verification-is-advisory.md.
EMAIL_VERIFICATION_TTL_HOURS=24
# console | drop. `console` prints recovery tokens to stdout so a developer can
# complete the reset and verification flows locally, and REFUSES TO BOOT under
# NODE_ENV=production —
# staging and production must set `drop` until a real transport exists.
MAIL_TRANSPORT=console
TRUST_PROXY=false

# Bearer token for GET /metrics: `Authorization: Bearer <token>`. Generate with
# openssl rand -base64 48; at least 32 characters. Empty leaves /metrics open,
# which is fine on a developer machine and a BOOT FAILURE under
# NODE_ENV=production: the endpoint shares the public port, so its password-reset
# counters would be a user-enumeration oracle
# (see docs/adr/0007-fail-closed-security-config.md).
METRICS_TOKEN=

# OTLP/HTTP collector BASE url — `/v1/traces` is appended for you. Empty means
# tracing is off: no SDK is constructed and no span is recorded, which is what
# every deployed environment runs until F-019 picks a backend (see
# docs/adr/0012-traces-without-a-backend.md). For local work:
# `docker compose -f ops/docker-compose.observability.yml up` and then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 with TRACE_SAMPLE_RATIO=1.0.
# Under NODE_ENV=production a plaintext http:// endpoint to a non-loopback host
# is a BOOT FAILURE, because the headers below are a credential.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated `k=v` pairs sent on every export — an API key for a SaaS
# collector, say: `authorization=Bearer <token>`. A CREDENTIAL: never logged,
# never on a span. Setting it with no endpoint is a boot failure.
OTEL_EXPORTER_OTLP_HEADERS=
# `service.name` on every span.
OTEL_SERVICE_NAME=agentic-todo
# Head sampling ratio, 0 to 1, applied to root spans and to an inbound
# traceparent alike — a caller cannot raise it by setting the sampled flag. Use
# 1.0 locally, where sampling only hides the span you were looking for.
TRACE_SAMPLE_RATIO=0.1

# CSRF origin allowlist, comma separated. An empty value disables the origin
# check, so the app refuses to boot with an empty value once a browser client is
# being served (see docs/adr/0007-fail-closed-security-config.md).
# 127.0.0.1 is here because Playwright drives the local server on that host.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Directory holding the built browser client. The default is correct for the
# image; `npm run build:web` writes it locally.
WEB_ROOT=dist/public
